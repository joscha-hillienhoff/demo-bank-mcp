# Mock bearer tokens for the mock bank API. Copy to .env and change the values.
# These are not real credentials; they only exist to exercise scope checks.

# Token with scope accounts:read
DEMO_BANK_READ_TOKEN=mock-read-token-change-me

# Token with scopes accounts:read and payments:write
DEMO_BANK_FULL_TOKEN=mock-full-token-change-me

# Base URL of the mock bank API that the MCP server calls (default: http://localhost:8000)
DEMO_BANK_API_URL=http://localhost:8000
